+	{ 127, "UP" },
+};
+
+void fill_macos_keymap(struct xkb_keymap *keymap, int *buttons, size_t count)
+{
+	for (size_t i = 0; i < count; ++i)
+		buttons[i] = -1;
+
+	for (size_t i = 0; i < sizeof(macos_buttons) / sizeof(macos_buttons[0]); ++i) {
+		size_t button = macos_buttons[i].button;
+		if (button >= count)
+			continue;
+		xkb_keycode_t code = xkb_keymap_key_by_name(keymap, macos_buttons[i].position);
+		if (code != XKB_KEYCODE_INVALID)
+			buttons[button] = (int)code;
+	}
+}
diff --git a/test/macos_keymap.c b/test/macos_keymap.c
new file mode 100644
index 0000000..e862d85
--- /dev/null
+++ b/test/macos_keymap.c
@@ -0,0 +1,33 @@
+#include <assert.h>
+#include <xkbcommon/xkbcommon.h>
+#include <xkbcommon/xkbcommon-keysyms.h>
+#include "macos_keymap.h"
+
+int main(void)
+{
+	struct xkb_context *context = xkb_context_new(XKB_CONTEXT_NO_FLAGS);
+	assert(context);
+	struct xkb_rule_names names = { .layout = "us" };
+	struct xkb_keymap *keymap = xkb_keymap_new_from_names(context, &names, XKB_KEYMAP_COMPILE_NO_FLAGS);
+	assert(keymap);
+	struct xkb_state *state = xkb_state_new(keymap);
+	assert(state);
+	int buttons[256];
+	fill_macos_keymap(keymap, buttons, sizeof(buttons) / sizeof(buttons[0]));
+	assert(buttons[0] == -1);
+	assert(buttons[255] == -1);
+	assert(xkb_state_key_get_one_sym(state, buttons[1]) == XKB_KEY_a);
+	assert(xkb_state_key_get_one_sym(state, buttons[15]) == XKB_KEY_e);
+	assert(xkb_state_key_get_one_sym(state, buttons[16]) == XKB_KEY_r);
+	assert(xkb_state_key_get_one_sym(state, buttons[45]) == XKB_KEY_slash);
+	assert(xkb_state_key_get_one_sym(state, buttons[54]) == XKB_KEY_Escape);
+	assert(xkb_state_key_get_one_sym(state, buttons[56]) == XKB_KEY_Super_L);
+	assert(xkb_state_key_get_one_sym(state, buttons[59]) == XKB_KEY_Alt_L);
+	xkb_state_update_key(state, buttons[57], XKB_KEY_DOWN);
+	assert(xkb_state_key_get_one_sym(state, buttons[1]) == XKB_KEY_A);
+	assert(xkb_state_key_get_one_sym(state, buttons[45]) == XKB_KEY_question);
+	xkb_state_unref(state);
+	xkb_keymap_unref(keymap);
+	xkb_context_unref(context);
+	return 0;
+}
