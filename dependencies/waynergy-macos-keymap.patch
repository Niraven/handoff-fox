+	{  36, "AD10" },
+	{  37, "RTRN" },
+	{  38, "AC09" },
+	{  39, "AC07" },
+	{  40, "AC11" },
+	{  41, "AC08" },
+	{  42, "AC10" },
+	{  43, "BKSL" },
+	{  44, "AB08" },
+	{  45, "AB10" },
+	{  46, "AB06" },
+	{  47, "AB07" },
